<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>C++ HTTP Server — Demo</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            max-width: 720px;
            margin: 48px auto;
            padding: 0 24px;
            color: #1a1a1a;
            line-height: 1.6;
        }
        h1 { margin-bottom: 8px; }
        h2 { margin-top: 32px; margin-bottom: 12px; color: #333; }
        p  { margin-bottom: 16px; color: #555; }
        code {
            background: #f0f0f0;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.9em;
        }
        .btn-group { display: flex; gap: 8px; margin-bottom: 16px; }
        button {
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: 500;
            transition: opacity 0.15s;
        }
        button:hover { opacity: 0.85; }
        .btn-get  { background: #2563eb; color: #fff; }
        .btn-post { background: #16a34a; color: #fff; }
        #output {
            background: #1e1e2e;
            color: #cdd6f4;
            padding: 20px;
            border-radius: 8px;
            min-height: 60px;
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 0.9em;
            white-space: pre-wrap;
            word-break: break-all;
        }
        .label {
            display: inline-block;
            font-size: 0.75em;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 4px;
            margin-right: 4px;
        }
        .label-get  { background: #dbeafe; color: #1d4ed8; }
        .label-post { background: #dcfce7; color: #15803d; }
    </style>
</head>
<body>
    <h1>C++ HTTP Server</h1>
    <p>Built from scratch using POSIX sockets and C++17. No frameworks.</p>

    <h2>Try the API</h2>
    <div class="btn-group">
        <button class="btn-get" onclick="testGet()">
            <span class="label label-get">GET</span> /api/status
        </button>
        <button class="btn-post" onclick="testPost()">
            <span class="label label-post">POST</span> /api/echo
        </button>
    </div>

    <h2>Response</h2>
    <pre id="output">Click a button above to send a request...</pre>

    <script>
        const output = document.getElementById('output');

        async function testGet() {
            output.textContent = 'GET /api/status ...\n';
            try {
                const res = await fetch('/api/status');
                const data = await res.json();
                output.textContent += '\nStatus: ' + res.status + '\n\n';
                output.textContent += JSON.stringify(data, null, 2);
            } catch (err) {
                output.textContent += '\nError: ' + err.message;
            }
        }

        async function testPost() {
            const body = {
                message: 'Hello from the browser!',
                timestamp: new Date().toISOString()
            };
            output.textContent = 'POST /api/echo\n';
            output.textContent += 'Body: ' + JSON.stringify(body) + '\n';
            try {
                const res = await fetch('/api/echo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const data = await res.json();
                output.textContent += '\nStatus: ' + res.status + '\n\n';
                output.textContent += JSON.stringify(data, null, 2);
            } catch (err) {
                output.textContent += '\nError: ' + err.message;
            }
        }
    </script>
</body>
</html>
